<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="demo_task_view_tree" model="ir.ui.view">
        <field name="name">demo.task.tree</field>
        <field name="model">demo.task</field>
        <field name="arch" type="xml">
            <tree decoration-danger="is_overdue" decoration-muted="state == 'cancel'">
                <field name="priority" widget="priority"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="deadline"/>
                <field name="is_overdue" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'in_progress'"
                       decoration-success="state == 'done'"/>
            </tree>
        </field>
    </record>

    <record id="demo_task_view_form" model="ir.ui.view">
        <field name="name">demo.task.form</field>
        <field name="model">demo.task</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" string="Start" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_done" string="Mark Done" type="object" class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('done', 'cancel')"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object" invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="priority" widget="priority" class="me-3"/>
                            <field name="name" placeholder="Task title..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </group>
                        <group>
                            <field name="deadline"/>
                            <field name="is_overdue" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Add details..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="demo_task_view_search" model="ir.ui.view">
        <field name="name">demo.task.search</field>
        <field name="model">demo.task</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <filter name="my_tasks" string="My Tasks" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="open" string="Open" domain="[('state', 'in', ('draft', 'in_progress'))]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_user" string="Assigned To" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="demo_task_action" model="ir.actions.act_window">
        <field name="name">Tasks</field>
        <field name="res_model">demo.task</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first demo task</p>
        </field>
    </record>

    <menuitem id="demo_menu_root" name="Demo" web_icon="base,static/description/icon.png" sequence="100"/>
    <menuitem id="demo_task_menu" name="Tasks" parent="demo_menu_root" action="demo_task_action" sequence="10"/>
</odoo>
